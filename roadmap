<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>IMO Digital &amp; Data — go-live roadmap</title>
<style>
  :root{
    --navy:#0000A0; --navy-soft:#6B6BC7; --red:#F60B45; --sky:#009EEA;
    --green:#22B573; --amber:#F0A800; --ink:#3C3C3C; --soft:#8C8C96;
    --rule:#E8E8F0; --rule-2:#C9C9DE; --tint:#F5F5FC;
    --font:"Mars Centra","Century Gothic","Futura","Avenir Next","Segoe UI",system-ui,sans-serif;
    --lane:118px; --names:268px; --region:56px;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  body{background:#fff;color:var(--ink);font-family:var(--font);-webkit-font-smoothing:antialiased;line-height:1.45}
  .wrap{max-width:1280px;margin:0 auto;padding:26px 22px 34px}

  h1{font-size:clamp(1.5rem,2.9vw,2.15rem);line-height:1.05;letter-spacing:-.025em;font-weight:800;color:var(--navy)}
  .meta{margin:0;font-size:.82rem;color:var(--soft)}
  .standfirst{margin-top:10px;font-size:1rem;max-width:66ch}

  .chart{position:relative;margin:82px 0 0}
  .barcode{height:66px;display:flex;align-items:flex-end;gap:1px}
  .day{flex:1 1 0;background:var(--rule);height:6px;border-radius:1px 1px 0 0}
  .day[data-n="1"]{height:24px;background:#9B9BE0}
  .day[data-n="2"]{height:40px;background:#6B6BC7}
  .day[data-n="3"]{height:53px;background:#3838B2}
  .day[data-n="4"]{height:66px;background:var(--navy)}

  .bands{position:absolute;left:0;right:0;top:0;height:66px}
  .band{position:absolute;top:0;bottom:0;border:0;background:transparent;padding:0;
        cursor:pointer;border-radius:0}
  .band::before{content:"";position:absolute;inset:0;background:var(--navy);opacity:0;
        transition:opacity .15s ease}
  .band:hover::before,.band.hot::before{opacity:.06}
  .band:focus-visible{outline:2px solid var(--sky);outline-offset:-2px}
  .bdiv{position:absolute;top:0;bottom:0;width:1px;background:var(--rule-2)}

  .paxis{display:flex;border-top:1px solid var(--rule-2);margin-top:0}
  .pcell{padding:7px 0 0;text-align:center;font-size:.72rem;color:var(--soft);
         border-right:1px solid var(--rule);overflow:hidden;white-space:nowrap}
  .pcell:last-child{border-right:0}
  .pcell b{display:block;font-size:.8rem;font-weight:800;color:var(--navy);letter-spacing:-.01em}
  .pcell span{display:block;margin-top:1px}

  .tip{position:absolute;z-index:20;pointer-events:none;background:#fff;
       border:1px solid var(--rule-2);border-radius:8px;padding:8px 11px;
       box-shadow:0 6px 18px rgba(0,0,0,.10);min-width:150px;opacity:0;
       transition:opacity .12s ease}
  .tip.on{opacity:1}
  .tip b{display:block;font-size:1.26rem;font-weight:800;color:var(--navy);
         letter-spacing:-.02em;line-height:1.05}
  .tip b small{font-size:.78rem;font-weight:700;color:var(--soft);margin-left:5px}
  .tip em{display:block;font-style:normal;font-size:.76rem;color:var(--ink);
          font-weight:700;margin-top:4px}
  .tip i{display:block;font-style:normal;font-size:.72rem;color:var(--soft);margin-top:3px}

  .caption{margin-top:12px;font-size:.82rem;color:var(--soft)}
  .figures{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;margin-top:26px;padding-top:20px;border-top:1px solid var(--rule-2)}
  .fig b{display:block;font-size:clamp(1.5rem,2.4vw,2rem);font-weight:800;color:var(--navy);letter-spacing:-.03em;line-height:1}
  .fig span{display:block;margin-top:5px;font-size:.82rem;color:var(--soft);max-width:22ch}

  .scrub{margin-top:26px;padding:16px 18px;border:1px solid var(--rule-2);border-radius:10px;display:flex;align-items:center;gap:20px;flex-wrap:wrap}
  .readout{min-width:200px}
  .readout b{display:block;font-size:1.18rem;font-weight:800;color:var(--navy);letter-spacing:-.02em}
  .readout span{font-size:.82rem;color:var(--soft)}
  .slider-cell{flex:1 1 300px;display:flex;align-items:center;gap:12px}
  input[type=range]{flex:1;appearance:none;-webkit-appearance:none;height:4px;border-radius:2px;background:var(--rule-2);outline:none}
  input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:20px;height:20px;border-radius:50%;background:var(--sky);border:3px solid #fff;box-shadow:0 0 0 1px var(--sky);cursor:grab}
  input[type=range]::-moz-range-thumb{width:20px;height:20px;border-radius:50%;background:var(--sky);border:3px solid #fff;box-shadow:0 0 0 1px var(--sky);cursor:grab}
  input[type=range]:focus-visible{box-shadow:0 0 0 3px rgba(0,158,234,.35)}
  button{font:inherit;font-size:.8rem;font-weight:700;color:var(--navy);background:#fff;border:1px solid var(--rule-2);border-radius:999px;padding:6px 13px;cursor:pointer}
  button:hover{border-color:var(--navy)}
  button:focus-visible{outline:2px solid var(--sky);outline-offset:2px}
  button[aria-pressed="true"]{background:var(--navy);border-color:var(--navy);color:#fff}

  .filterbar{margin:24px 0 16px;display:flex;flex-direction:column;gap:9px}
  .frow{display:flex;flex-wrap:wrap;gap:7px;align-items:center}
  .frow>em{font-style:normal;font-size:.76rem;color:var(--soft);width:58px;flex:0 0 auto}

  .board{overflow-x:auto;padding-bottom:4px}
  .board-inner{min-width:1000px}
  .months{display:grid;grid-template-columns:calc(var(--lane) + var(--names) + var(--region)) 1fr;border-bottom:2px solid var(--navy)}
  .mhead{display:flex;align-items:flex-end;justify-content:flex-end;padding:0 10px 9px 0;font-size:.68rem;font-weight:700;color:var(--soft)}
  .mgrid{display:grid;grid-template-columns:repeat(4,1fr)}
  .mgrid div{padding:9px 0 8px;text-align:center;font-weight:700;font-size:.86rem;letter-spacing:.06em;color:var(--soft)}
  .mgrid div.now{color:var(--navy);background:var(--tint)}

  .lane{display:grid;grid-template-columns:var(--lane) 1fr;border-bottom:1px solid var(--rule-2)}
  .lane:last-child{border-bottom:0}
  .lane-name{padding:10px 12px 10px 0;font-weight:800;color:var(--navy);font-size:.84rem;display:flex;flex-direction:column;justify-content:center}
  .lane-name small{display:block;font-weight:600;color:var(--soft);font-size:.66rem;margin-top:2px;letter-spacing:.05em}
  .row{display:grid;grid-template-columns:var(--names) var(--region) 1fr;border-bottom:1px solid var(--rule);transition:opacity .2s ease}
  .lane .row:last-child{border-bottom:0}
  .row.dimmed{opacity:.13}
  .rname{display:flex;align-items:center;font-size:.76rem;font-weight:700;color:var(--navy);padding-right:10px;height:34px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .rname span{overflow:hidden;text-overflow:ellipsis}
  .rregion{display:flex;align-items:center;justify-content:flex-end;font-size:.65rem;font-weight:700;color:var(--navy-soft);padding-right:12px;height:34px;letter-spacing:.03em}
  .track{position:relative;height:34px;background:linear-gradient(to right,#fff 0 25%,var(--tint) 25% 50%,#fff 50% 100%)}
  .track i{position:absolute;top:0;bottom:0;width:1px;background:var(--rule)}
  .nowline{position:absolute;top:0;bottom:0;width:2px;background:var(--sky);z-index:2;pointer-events:none}

  .pill{position:absolute;top:50%;transform:translateY(-50%);height:25px;border:1.5px solid var(--navy);border-radius:13px;background:#fff;display:flex;align-items:center;gap:6px;padding:0 9px;white-space:nowrap;font-size:.73rem;font-weight:700;color:var(--navy);z-index:1;transition:background .3s ease,color .3s ease}
  .pill.done{background:var(--navy);color:#fff}
  .pill.done .sep{background:rgba(255,255,255,.4)}
  .mk{width:10px;height:10px;border-radius:50%;border:1.5px solid var(--navy);background:#fff;
      flex:0 0 auto;transition:background .25s ease,border-color .25s ease}
  .mk.eu{background:var(--navy)}
  .pill.done .mk{border-color:#fff;background:var(--navy)}
  .pill.done .mk.eu{background:#fff}

  /* status colour outranks the filled-pill treatment on either background */
  .pill .mk.live,.pill.done .mk.live{border-color:var(--green);background:var(--green)}
  .pill .mk.live.tech{background:#fff}
  .pill.done .mk.live.tech{background:var(--navy)}
  .pill .mk.hyper,.pill.done .mk.hyper{border-color:var(--amber);background:var(--amber)}
  .pill .mk.hyper.tech{background:#fff}
  .pill.done .mk.hyper.tech{background:var(--navy)}
  .pill .mk.issue,.pill.done .mk.issue{border-color:var(--red);background:var(--red)}
  .pill .mk.issue.tech{background:#fff}
  .pill.done .mk.issue.tech{background:var(--navy)}
  .pill.done .mk.live,.pill.done .mk.hyper,.pill.done .mk.issue{
      box-shadow:0 0 0 1px rgba(255,255,255,.5)}
  .sep{flex:1 1 auto;min-width:12px;height:1px;background:var(--rule-2)}
  .pill.range{border-style:dashed;border-color:var(--navy-soft);font-weight:600;color:var(--navy-soft);overflow:hidden}
  .pill.range b{color:var(--navy);font-weight:800}
  .pill.done.range b{color:#fff}

  .key{display:flex;flex-wrap:wrap;gap:16px;margin-top:20px;font-size:.78rem;color:var(--soft)}
  .key i{width:10px;height:10px;border-radius:50%;display:inline-block;vertical-align:-1px;margin-right:6px}

  footer{padding:20px 0 0;margin-top:26px;border-top:1px solid var(--rule-2);color:var(--soft);font-size:.76rem}
  footer p{max-width:100ch;margin-top:8px}

  @media (max-width:820px){
    .wrap{padding:20px 16px 28px}
    .figures{grid-template-columns:repeat(2,1fr);gap:16px}
    .frow>em{width:100%}
  }
  @media (prefers-reduced-motion:reduce){*{transition:none!important}}
</style>
</head>
<body>
<div class="wrap">

  <p class="meta">Last updated Mon 28 Sep 2026, 12:44 PM ET</p>
  <p class="standfirst">Every tracked go-live between August and November, delivered and upcoming. Drag the
    slider to move through the calendar and watch each milestone land.</p>

  <div class="chart">
    <div class="barcode" id="barcode" aria-hidden="true"></div>
    <div class="bands" id="bands"></div>
    <div class="tip" id="tip" role="status" aria-live="polite"></div>
  </div>
  <div class="paxis" id="paxis"></div>
  <p class="caption">Every day from 1 August to 30 November, grouped into Mars 13-period
    calendar periods. Bars rise where go-lives fall. Hover or tab a period for its detail.</p>

  <div class="figures">
    <div class="fig"><b id="f1">26</b><span>initiatives going live</span></div>
    <div class="fig"><b id="f2">46</b><span>go lives</span></div>
    <div class="fig"><b id="f3">11</b><span>functions delivering at once</span></div>
    <div class="fig"><b id="f4">19</b><span>go lives in the busiest period</span></div>
  </div>

  <div class="scrub">
    <div class="readout">
      <b id="scrubDate">28 September 2026</b>
      <span id="scrubCount">delivered so far</span>
    </div>
    <div class="slider-cell">
      <input type="range" id="slider" min="0" max="121" value="58"
             aria-label="Move through the calendar to see milestones go live">
      <button id="todayBtn" type="button">Today</button>
    </div>
  </div>

  <div class="filterbar">
    <div class="frow" id="fnFilters"><em>Function</em></div>
    <div class="frow" id="rgFilters"><em>Region</em></div>
  </div>

  <div class="board">
    <div class="board-inner">
      <div class="months">
        <div class="mhead">Impacted region</div>
        <div class="mgrid"><div>AUGUST</div><div>SEPTEMBER</div><div>OCTOBER</div><div>NOVEMBER</div></div>
      </div>
      <div id="board"></div>
    </div>
  </div>

  <div class="key">
    <span><i style="background:var(--green)"></i>Delivered</span>
    <span><i style="background:var(--navy)"></i>End-user go-live ahead</span>
    <span><i style="border:1.5px solid var(--navy);background:#fff"></i>Technical go-live ahead</span>
    <span><i style="background:var(--amber)"></i>In hypercare</span>
    <span><i style="background:var(--red)"></i>Issue</span>
  </div>

  <footer>
    <strong style="color:var(--ink)">Source: go-live tracker, 25 September 2026, plus the November pending tab.</strong>
    <p>Hollow circles are technical go-lives, when a system is switched on. Filled circles are end-user go-lives,
      when Associates start working in it. Australia's technical go-live (3 Aug) and HRIS for Accelerator
      (21 Jul) were confirmed outside the tracker. TPM Mexico for Mars, TPM Mexico for Kellanova and ODCP Mexico
      share Go Live 1 dates and are shown as one row. M/K Wireless Network Integration runs as three site waves
      between 30 Sep and 23 Oct — corporate Wi-Fi, Wells St / RXBAR / KIND / NB, and GIC. TPM TruFru carries a
      second technical go-live on 25 Nov, after its 12 Oct end-user date. Rows without an end-user circle have
      no end-user date in the tracker yet.</p>
    <p>Strictly confidential information for discussion purposes only. Any proposals are only that and remain
      subject to legally required processes, where applicable. Copyright &copy; 2026 Mars, Incorporated.</p>
  </footer>
</div>

<script>
(function(){
  var START=new Date(2026,7,1), END=new Date(2026,10,30);
  function dayIndex(dt){
    return Math.round((Date.UTC(dt.getFullYear(),dt.getMonth(),dt.getDate())
                     - Date.UTC(2026,7,1))/86400000);
  }
  function dayAt(i){return new Date(2026,7,1+i);}
  var DAYS=dayIndex(END);
  var TODAY=new Date(2026,8,28);
  var MO=["January","February","March","April","May","June","July","August","September","October","November","December"];
  var MOS=["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
  function d(y,m,day){return new Date(y,m-1,day);}
  function pct(dt){return dayIndex(dt)/DAYS*100;}
  function fmt(dt){return dt.getDate()+" "+MO[dt.getMonth()]+" "+dt.getFullYear();}
  function sf(dt){return dt.getDate()+" "+MOS[dt.getMonth()];}

  // status: omit for none, "hypercare" or "issue" to override the colour
  var LANES=[
    {name:"Sales",sub:"RETAIL EXECUTION",rows:[
      {n:"Australia Replatforming",rg:"AMEA",tech:d(2026,8,3),eu:d(2026,8,12)},
      {n:"Mexico DDS Replatform",rg:"LATAM",tech:d(2026,9,4),eu:d(2026,9,7),status:"hypercare"},
      {n:"AMEA India DHS SFA Integration",rg:"AMEA",tech:d(2026,10,3),eu:d(2026,10,4)},
      {n:"NA REx Transition & Transformation",rg:"NA",tech:d(2026,10,26),eu:d(2026,11,30)}]},
    {name:"Sales",sub:"TRADE PROMOTION",rows:[
      {n:"TPM Canada (Mars)",rg:"NA",tech:d(2026,9,21),eu:d(2026,9,28)},
      {n:"TPM TruFru (H&W)",rg:"Global",tech:d(2026,9,28),eu:d(2026,10,12)},
      {n:"TPM & ODCP Mexico · GL1",rg:"LATAM",tech:d(2026,10,9),eu:d(2026,10,19)}]},
    {name:"Finance",rows:[
      {n:"Anaplan IVCP / AEP",rg:"Global",tech:d(2026,9,28),eu:d(2026,10,12)}]},
    {name:"Commercial",rows:[
      {n:"Combined Spend Analytics",rg:"Global",tech:d(2026,10,30),eu:d(2026,10,30)},
      {n:"CLM Re-Design",rg:"Global",tech:d(2026,11,2),eu:d(2026,11,2)}]},
    {name:"Region",sub:"CHINA JV",rows:[
      {n:"China JV ERP Enablement",rg:"China",tech:d(2026,9,18),eu:d(2026,11,1)},
      {n:"China JV Business Integration",rg:"China",tech:d(2026,10,23)}]},
    {name:"People & Organization",rows:[
      {n:"HRIS (Accelerator)",rg:"Global",eu:d(2026,8,12)}]},
    {name:"Supply",sub:"KALEIDOSCOPE",rows:[
      {n:"Frozen – McLellan",rg:"NA",tech:d(2026,9,8),eu:d(2026,9,28)},
      {n:"Tru Fru Victorville – inbound",rg:"NA",tech:d(2026,9,11),eu:d(2026,9,15)},
      {n:"Rx into Victorville – inbound",rg:"NA",tech:d(2026,9,22),eu:d(2026,10,5)},
      {n:"Tru Fru Victorville – outbound",rg:"NA",tech:d(2026,10,6),eu:d(2026,10,12)},
      {n:"Rx into Victorville – outbound",rg:"NA",tech:d(2026,10,27)},
      {n:"Frozen MW Quakertown",rg:"NA",eu:d(2026,10,27)}]},
    {name:"Accelerator",rows:[
      {n:"Kind & Natures Bakery AD",rg:"NA",tech:d(2026,10,12),eu:d(2026,11,9)}]},
    {name:"Growth & Marketing",rows:[
      {n:"Agency Ecosystem – DAM",rg:"Global",tech:d(2026,11,11),eu:d(2026,11,23)}]},
    {name:"Digital Associate Experience",rows:[
      {n:"Cross-company app access",rg:"Global",from:d(2026,8,10),to:d(2026,10,31),
       note:"Timing aligned to regional placement timelines"},
      {n:"M/K Wireless Network Integration",rg:"Global",from:d(2026,9,30),to:d(2026,10,23)},
      {n:"M/K Network Interconnection",rg:"Global",tech:d(2026,10,31),eu:d(2026,10,31)},
      {n:"Cyber Okta (OAG)",rg:"Global",tech:d(2026,11,20)},
      {n:"Cyber SME IDM HKV AD Connector",rg:"Global",tech:d(2026,11,30)}]}
  ];

  /* ---------- hero barcode + figures ---------- */
  var counts={},projects=0;
  LANES.forEach(function(L){L.rows.forEach(function(r){
    projects++;
    [r.tech,r.eu,r.from,r.to].forEach(function(dt){
      if(!dt)return;
      var k=dayIndex(dt);
      counts[k]=(counts[k]||0)+1;
    });
  });});
  var bc=document.getElementById("barcode"),frag=document.createDocumentFragment();
  for(var i=0;i<=DAYS;i++){
    var el=document.createElement("div");
    el.className="day";
    if(counts[i])el.setAttribute("data-n",Math.min(counts[i],4));
    frag.appendChild(el);
  }
  bc.appendChild(frag);

  /* ---------- Mars 13-period calendar ----------
     PERIOD_ANCHOR is the first day of Period 1 of the fiscal year. Periods are
     four weeks (28 days) each. Change this one line if the anchor differs.      */
  var PERIOD_ANCHOR=new Date(2025,11,29);      // Mon 29 Dec 2025 -> P1
  function anchorIndex(dt){
    return Math.round((Date.UTC(dt.getFullYear(),dt.getMonth(),dt.getDate())
                     - Date.UTC(2025,11,29))/86400000);
  }
  var periods=[];
  (function(){
    var startOff=anchorIndex(START), endOff=anchorIndex(END);
    var first=Math.floor(startOff/28), last=Math.floor(endOff/28);
    for(var pi=first;pi<=last;pi++){
      var pStart=new Date(PERIOD_ANCHOR.getFullYear(),PERIOD_ANCHOR.getMonth(),
                          PERIOD_ANCHOR.getDate()+pi*28);
      var pEnd=new Date(PERIOD_ANCHOR.getFullYear(),PERIOD_ANCHOR.getMonth(),
                        PERIOD_ANCHOR.getDate()+pi*28+27);
      var a=Math.max(dayIndex(pStart),0), b=Math.min(dayIndex(pEnd),DAYS);
      var n=0; for(var k=a;k<=b;k++) n+=counts[k]||0;
      periods.push({
        num:(pi%13)+1, start:pStart, end:pEnd, a:a, b:b, n:n,
        partial:(dayIndex(pStart)<0||dayIndex(pEnd)>DAYS)
      });
    }
  })();

  var bandBox=document.getElementById("bands");
  var axis=document.getElementById("paxis");
  var tip=document.getElementById("tip");

  function showTip(p,band){
    while(tip.firstChild)tip.removeChild(tip.firstChild);
    var b=document.createElement("b");
    b.appendChild(document.createTextNode(String(p.n)));
    var sm=document.createElement("small");
    sm.textContent=p.n===1?"go live":"go lives";
    b.appendChild(sm);
    var em=document.createElement("em");
    em.textContent="Period "+p.num+(p.partial?" (part shown)":"");
    var i1=document.createElement("i");
    i1.textContent=sf(p.start)+" – "+sf(p.end);
    tip.appendChild(b);tip.appendChild(em);tip.appendChild(i1);
    if(p.n){
      var peak=-1,pk=0;
      for(var k=p.a;k<=p.b;k++){if((counts[k]||0)>pk){pk=counts[k];peak=k;}}
      var i2=document.createElement("i");
      i2.textContent="Busiest day "+sf(dayAt(peak))+" ("+pk+")";
      tip.appendChild(i2);
    }
    tip.classList.add("on");
    var mid=(p.a+p.b)/2/DAYS*100;
    tip.style.left=mid+"%";
    tip.style.transform="translate(-50%,-108%)";
    tip.style.top="0px";
    var r=tip.getBoundingClientRect(), br=bandBox.getBoundingClientRect();
    if(r.left<br.left){tip.style.left="0%";tip.style.transform="translate(0,-108%)";}
    if(r.right>br.right){tip.style.left="100%";tip.style.transform="translate(-100%,-108%)";}
    band.classList.add("hot");
  }
  function hideTip(band){tip.classList.remove("on");if(band)band.classList.remove("hot");}

  periods.forEach(function(p,idx){
    var left=p.a/DAYS*100, width=(p.b-p.a+1)/DAYS*100;
    var band=document.createElement("button");
    band.type="button";band.className="band";
    band.style.left=left+"%";band.style.width=width+"%";
    band.setAttribute("aria-label","Period "+p.num+", "+sf(p.start)+" to "+sf(p.end)+
                      ", "+p.n+(p.n===1?" go live":" go lives"));
    band.addEventListener("mouseenter",function(){showTip(p,band);});
    band.addEventListener("mouseleave",function(){hideTip(band);});
    band.addEventListener("focus",function(){showTip(p,band);});
    band.addEventListener("blur",function(){hideTip(band);});
    bandBox.appendChild(band);
    if(idx>0){
      var dv=document.createElement("div");dv.className="bdiv";dv.style.left=left+"%";
      bandBox.appendChild(dv);
    }
    var cell=document.createElement("div");
    cell.className="pcell";
    cell.style.flex="0 0 "+width+"%";
    if(width>=3.5){
      var lab=document.createElement("b");
      lab.textContent=width<7?("P"+p.num):("Period "+p.num);
      var cnt=document.createElement("span");
      cnt.textContent=width<7?String(p.n):(p.n+(p.n===1?" go live":" go lives"));
      cell.appendChild(lab);cell.appendChild(cnt);
      cell.title="Period "+p.num+" · "+sf(p.start)+" – "+sf(p.end);
    } else {
      cell.title="Period "+p.num+" · "+p.n+" go lives";
    }
    axis.appendChild(cell);
  });

  var best=0;
  periods.forEach(function(p){if(p.n>best)best=p.n;});
  var total=0;Object.keys(counts).forEach(function(k){total+=counts[k];});
  var laneNames=[];LANES.forEach(function(L){if(laneNames.indexOf(L.name)<0)laneNames.push(L.name);});
  document.getElementById("f1").textContent=projects;
  document.getElementById("f2").textContent=total;
  document.getElementById("f3").textContent=laneNames.length;
  document.getElementById("f4").textContent=best;

  /* ---------- board ---------- */
  var board=document.getElementById("board");
  var regions=[];
  LANES.forEach(function(L){
    var lane=document.createElement("div");lane.className="lane";
    var nm=document.createElement("div");nm.className="lane-name";
    nm.appendChild(document.createTextNode(L.name));
    if(L.sub){var sm=document.createElement("small");sm.textContent=L.sub;nm.appendChild(sm);}
    lane.appendChild(nm);

    var rowsWrap=document.createElement("div");
    L.rows.forEach(function(r){
      if(regions.indexOf(r.rg)<0)regions.push(r.rg);
      var row=document.createElement("div");row.className="row";
      row.dataset.lane=L.name;row.dataset.region=r.rg;

      var nameCell=document.createElement("div");nameCell.className="rname";
      var nameTxt=document.createElement("span");nameTxt.textContent=r.n;nameCell.title=r.n;nameCell.appendChild(nameTxt);
      var rgCell=document.createElement("div");rgCell.className="rregion";rgCell.textContent=r.rg;
      var track=document.createElement("div");track.className="track";

      for(var g=1;g<4;g++){var gl=document.createElement("i");gl.style.left=(g*25)+"%";track.appendChild(gl);}
      var nl=document.createElement("div");nl.className="nowline";track.appendChild(nl);

      var pill=document.createElement("div");
      pill.className="pill"+(r.from?" range":"");
      if(r.status)pill.dataset.status=r.status;

      function mark(cls,dt){
        var m=document.createElement("span");
        m.className="mk "+cls;m.dataset.on=dayIndex(dt);
        if(r.status)m.dataset.status=r.status;
        return m;
      }
      function txt(t,tag){var e=document.createElement(tag||"span");e.textContent=t;return e;}

      if(r.from){
        pill.style.left=pct(r.from)+"%";
        pill.style.width=(pct(r.to)-pct(r.from))+"%";
        pill.appendChild(mark("eu",r.from));
        pill.appendChild(txt(sf(r.from)+" – "+sf(r.to),"b"));
        if(r.note){var nt=txt(r.note);nt.style.marginLeft="4px";pill.appendChild(nt);}
        var rsp=document.createElement("span");rsp.className="sep";rsp.style.background="transparent";
        pill.appendChild(rsp);
        pill.appendChild(mark("eu",r.to));
        pill.dataset.done=dayIndex(r.to);
      } else if(r.tech && r.eu && r.tech.getTime()===r.eu.getTime()){
        pill.style.left=pct(r.tech)+"%";
        pill.appendChild(mark("tech",r.tech));
        var m2=mark("eu",r.eu);m2.style.marginLeft="-4px";pill.appendChild(m2);
        pill.appendChild(txt(sf(r.tech)));
        pill.dataset.done=dayIndex(r.eu);
      } else if(r.tech && r.eu){
        pill.style.left=pct(r.tech)+"%";
        pill.style.minWidth=(pct(r.eu)-pct(r.tech))+"%";
        pill.appendChild(mark("tech",r.tech));
        pill.appendChild(txt(sf(r.tech)));
        var sp=document.createElement("span");sp.className="sep";pill.appendChild(sp);
        pill.appendChild(mark("eu",r.eu));
        pill.appendChild(txt(sf(r.eu)));
        pill.dataset.done=dayIndex(r.eu);
      } else {
        var only=r.tech||r.eu;
        pill.style.left=pct(only)+"%";
        pill.appendChild(mark(r.tech?"tech":"eu",only));
        pill.appendChild(txt(sf(only)));
        pill.dataset.done=dayIndex(only);
      }

      track.appendChild(pill);
      row.appendChild(nameCell);row.appendChild(rgCell);row.appendChild(track);
      rowsWrap.appendChild(row);
    });
    lane.appendChild(rowsWrap);
    board.appendChild(lane);
  });

  /* keep every pill inside its track, whatever the rendered width */
  var pills=[].slice.call(document.querySelectorAll(".pill"));
  function clampPills(){
    pills.forEach(function(p){
      p.style.marginLeft="0px";
      var tw=p.parentNode.clientWidth, pw=p.offsetWidth;
      var left=parseFloat(p.style.left)/100*tw;
      var over=(left+pw)-tw;
      if(over>0)p.style.marginLeft=(-over-1)+"px";
    });
  }

  /* ---------- scrubbing ---------- */
  var slider=document.getElementById("slider");slider.max=DAYS;
  var marks=[].slice.call(document.querySelectorAll(".mk"));
  var lines=[].slice.call(document.querySelectorAll(".nowline"));

  function apply(idx){
    var done=0;
    marks.forEach(function(m){
      var live=Number(m.dataset.on)<=idx;
      m.classList.toggle("live",live && !m.dataset.status);
      m.classList.toggle("hyper",!!(live && m.dataset.status==="hypercare"));
      m.classList.toggle("issue",!!(live && m.dataset.status==="issue"));
      if(live)done++;
    });
    pills.forEach(function(p){p.classList.toggle("done",Number(p.dataset.done)<=idx);});
    var left=(idx/DAYS)*100;
    lines.forEach(function(l){l.style.left=left+"%";});
    document.getElementById("scrubDate").textContent=fmt(dayAt(idx));
    document.getElementById("scrubCount").textContent=done+" of "+marks.length+" go lives delivered";
  }

  var todayIdx=dayIndex(TODAY);
  slider.value=todayIdx;
  slider.addEventListener("input",function(){apply(Number(slider.value));});
  document.getElementById("todayBtn").addEventListener("click",function(){slider.value=todayIdx;apply(todayIdx);});

  /* ---------- filters ---------- */
  var rows=[].slice.call(document.querySelectorAll(".row"));
  var fn="all", rg="all";
  function refresh(){
    rows.forEach(function(r){
      var hide=(fn!=="all"&&r.dataset.lane!==fn)||(rg!=="all"&&r.dataset.region!==rg);
      r.classList.toggle("dimmed",hide);
    });
  }
  function group(box,values,set){
    function add(label,value,pressed){
      var b=document.createElement("button");
      b.type="button";b.textContent=label;
      b.setAttribute("aria-pressed",pressed?"true":"false");
      b.addEventListener("click",function(){
        [].forEach.call(box.querySelectorAll("button"),function(c){c.setAttribute("aria-pressed","false");});
        b.setAttribute("aria-pressed","true");
        set(value);refresh();
      });
      box.appendChild(b);
    }
    add("All","all",true);
    values.forEach(function(v){add(v,v,false);});
  }
  group(document.getElementById("fnFilters"),laneNames,function(v){fn=v;});
  group(document.getElementById("rgFilters"),regions,function(v){rg=v;});

  apply(todayIdx);
  clampPills();
  window.addEventListener("resize",clampPills);
})();
</script>
</body>
</html>